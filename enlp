              <span>Encourager la qualité et le professionnalisme.</span>
            </div>

            <div class="value">
              <strong>🤝 Engagement</strong>
              <span>Former des professionnels responsables.</span>
            </div>

          </div>

        </div>

      </div>

    </section>


    <!-- ================= FORMATIONS ================= -->

    <section id="formations">

      <div class="container">

        <div class="section-header">

          <span>Nos formations</span>

          <h2>
            Des formations pour construire votre avenir
          </h2>

          <p>
            Découvrez nos différents parcours de formation
