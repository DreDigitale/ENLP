<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>École Normale Louise Pasquier | ENLP</title>

  <meta
    name="description"
    content="École Normale Louise Pasquier — Formation, éducation et avenir des professionnels de l'éducation."
  >

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --primary: #0f8b8d;
      --primary-dark: #086466;
      --secondary: #e9f7f5;
      --dark: #243746;
      --text: #52616b;
      --white: #ffffff;
      --light: #f7faf9;
      --border: #e5eeee;
      --gold: #e8a23a;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: var(--white);
      color: var(--dark);
      line-height: 1.6;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    img {
      max-width: 100%;
      display: block;
    }

    .container {
      width: min(1180px, 92%);
      margin: auto;
    }

    /* ================= HEADER ================= */

    header {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: rgba(255,255,255,0.97);
      border-bottom: 1px solid var(--border);
      backdrop-filter: blur(10px);
    }

    .navbar {
      min-height: 78px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 25px;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 12px;
      font-weight: 800;
    }

    .logo-icon {
      width: 46px;
      height: 46px;
      border-radius: 14px;
      background: var(--primary);
      color: white;
      display: grid;
      place-items: center;
      font-size: 20px;
      box-shadow: 0 8px 20px rgba(15,139,141,0.22);
    }

    .logo-text {
      line-height: 1.15;
    }

    .logo-text strong {
      display: block;
      font-size: 15px;
    }

    .logo-text span {
      font-size: 10px;
      color: var(--text);
      letter-spacing: 1.5px;
    }

    nav {
      display: flex;
      align-items: center;
      gap: 28px;
    }

    nav a {
      font-size: 14px;
      font-weight: 600;
      color: #475761;
      transition: 0.25s;
    }

    nav a:hover {
      color: var(--primary);
    }

    .nav-right {
      display: flex;
      align-items: center;
      gap: 15px;
    }

    .language {
      border: none;
      background: transparent;
      font-weight: 700;
      cursor: pointer;
      color: var(--dark);
    }

    .whatsapp-btn {
      background: #20b96c;
      color: white;
      padding: 12px 18px;
      border-radius: 30px;
      font-weight: 700;
      font-size: 13px;
      transition: 0.25s;
    }

    .whatsapp-btn:hover {
      transform: translateY(-2px);
      background: #159957;
    }

    .menu-btn {
      display: none;
      border: none;
      background: var(--secondary);
      color: var(--primary-dark);
      font-size: 25px;
      padding: 8px 12px;
      border-radius: 10px;
      cursor: pointer;
    }

    /* ================= HERO ================= */

    .hero {
      padding: 75px 0 85px;
      background:
        radial-gradient(circle at 10% 10%, #e7f8f5 0, transparent 30%),
        linear-gradient(180deg, #fff 0%, #f8fcfb 100%);
      overflow: hidden;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 0.95fr 1.05fr;
      align-items: center;
      gap: 65px;
    }

    .badge {
      display: inline-flex;
      padding: 8px 14px;
      border-radius: 30px;
      background: var(--secondary);
      color: var(--primary-dark);
      font-weight: 800;
      font-size: 12px;
      letter-spacing: 1px;
      margin-bottom: 20px;
    }

    .hero h1 {
      font-size: clamp(42px, 5vw, 68px);
      line-height: 1.02;
      letter-spacing: -2px;
      margin-bottom: 25px;
      color: var(--dark);
    }

    .hero h1 span {
      color: var(--primary);
    }

    .hero p {
      color: var(--text);
      font-size: 17px;
      max-width: 570px;
      margin-bottom: 30px;
    }

    .hero-buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
    }

    .btn {
      padding: 14px 22px;
      border-radius: 12px;
      font-weight: 800;
      border: 1px solid transparent;
      display: inline-block;
      transition: 0.25s;
      cursor: pointer;
    }

    .btn-primary {
      background: var(--primary);
      color: white;
    }

    .btn-primary:hover {
      background: var(--primary-dark);
      transform: translateY(-2px);
    }

    .btn-outline {
      border-color: var(--border);
      background: white;
      color: var(--dark);
    }

    .btn-outline:hover {
      border-color: var(--primary);
      color: var(--primary);
    }

    .hero-image-wrap {
      position: relative;
    }

    .hero-image {
      height: 500px;
      width: 100%;
      object-fit: cover;
      border-radius: 30px;
      box-shadow: 0 25px 60px rgba(36,55,70,0.18);
    }

    .floating-card {
      position: absolute;
      bottom: -25px;
      left: -25px;
      background: white;
      padding: 18px 22px;
      border-radius: 18px;
      box-shadow: 0 15px 40px rgba(0,0,0,0.12);
      display: flex;
      gap: 13px;
      align-items: center;
    }

    .floating-icon {
      width: 43px;
      height: 43px;
      border-radius: 12px;
      background: var(--secondary);
      color: var(--primary);
      display: grid;
      place-items: center;
      font-size: 20px;
    }

    .floating-card strong {
      display: block;
    }

    .floating-card small {
      color: var(--text);
    }

    /* ================= SECTIONS ================= */

    section {
      padding: 90px 0;
    }

    .section-header {
      text-align: center;
      max-width: 700px;
      margin: 0 auto 50px;
    }

    .section-header span {
      color: var(--primary);
      font-size: 13px;
      font-weight: 900;
      letter-spacing: 1.5px;
      text-transform: uppercase;
    }

    .section-header h2 {
      font-size: clamp(30px, 4vw, 45px);
      margin: 10px 0 15px;
    }

    .section-header p {
      color: var(--text);
    }

    /* ================= ABOUT ================= */

    .about {
      background: var(--light);
    }

    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      align-items: center;
    }

    .about-image {
      width: 100%;
      height: 450px;
      object-fit: cover;
      border-radius: 25px;
    }

    .about-content h2 {
      font-size: 42px;
      margin-bottom: 20px;
    }

    .about-content p {
      color: var(--text);
      margin-bottom: 17px;
    }

    .values {
      display: grid;
      grid-template-columns: repeat(2,1fr);
      gap: 15px;
      margin-top: 25px;
    }

    .value {
      padding: 18px;
      background: white;
      border: 1px solid var(--border);
      border-radius: 15px;
    }

    .value strong {
      display: block;
      margin-bottom: 5px;
    }

    .value span {
      color: var(--text);
      font-size: 13px;
    }

    /* ================= FORMATIONS ================= */

    .cards {
      display: grid;
      grid-template-columns: repeat(3,1fr);
      gap: 22px;
    }

    .card {
      border: 1px solid var(--border);
      background: white;
      border-radius: 20px;
      padding: 28px;
      transition: 0.3s;
    }

    .card:hover {
      transform: translateY(-6px);
      box-shadow: 0 18px 45px rgba(36,55,70,0.10);
      border-color: #cce7e4;
    }

    .card-icon {
      width: 52px;
      height: 52px;
      display: grid;
      place-items: center;
      background: var(--secondary);
      border-radius: 15px;
      color: var(--primary);
      font-size: 23px;
      margin-bottom: 20px;
    }

    .card h3 {
      margin-bottom: 10px;
      font-size: 20px;
    }

    .card p {
      color: var(--text);
      font-size: 14px;
    }

    /* ================= ADMISSION ================= */

    .admission {
      background: var(--dark);
      color: white;
    }

    .admission-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      align-items: center;
    }

    .admission h2 {
      font-size: 42px;
      line-height: 1.1;
      margin-bottom: 18px;
    }

    .admission p {
      color: #d5e0e3;
      margin-bottom: 25px;
    }

    .steps {
      display: grid;
      gap: 15px;
    }

    .step {
      display: flex;
      gap: 15px;
      padding: 18px;
      background: rgba(255,255,255,0.07);
      border-radius: 15px;
    }

    .step-number {
      min-width: 35px;
      height: 35px;
      border-radius: 50%;
      background: var(--primary);
      display: grid;
      place-items: center;
      font-weight: 800;
    }

    /* ================= GALLERY ================= */

    .gallery {
      display: grid;
      grid-template-columns: repeat(4,1fr);
      gap: 15px;
    }

    .gallery img {
      width: 100%;
      height: 220px;
      object-fit: cover;
      border-radius: 17px;
      transition: 0.3s;
    }

    .gallery img:hover {
      transform: scale(1.02);
    }

    /* ================= CONTACT ================= */

    .contact {
      background: var(--light);
    }

    .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }

    .contact-box {
      background: white;
      border: 1px solid var(--border);
      padding: 30px;
      border-radius: 20px;
    }

    .contact-item {
      display: flex;
      gap: 15px;
      margin: 20px 0;
    }

    .contact-icon {
      width: 45px;
      height: 45px;
      flex-shrink: 0;
      border-radius: 12px;
      background: var(--secondary);
      color: var(--primary);
      display: grid;
      place-items: center;
    }

    .contact-item strong {
      display: block;
    }

    .contact-item span {
      color: var(--text);
      font-size: 14px;
    }

    .contact-cta {
      background: var(--primary);
      color: white;
      padding: 40px;
      border-radius: 25px;
    }

    .contact-cta h2 {
      font-size: 35px;
      margin-bottom: 15px;
    }

    .contact-cta p {
      margin-bottom: 25px;
      color: #e2ffff;
    }

    /* ================= FOOTER ================= */

    footer {
      background: #182934;
      color: white;
      padding: 35px 0;
    }

    .footer-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
    }

    footer p {
      color: #b8c6cb;
      font-size: 13px;
    }

    .footer-brand {
      font-weight: 800;
    }

    /* ================= RESPONSIVE ================= */

    @media (max-width: 950px) {

      nav {
        position: absolute;
        top: 78px;
        left: 0;
        width: 100%;
        background: white;
        padding: 20px;
        flex-direction: column;
        align-items: flex-start;
        border-bottom: 1px solid var(--border);
        display: none;
      }

      nav.active {
        display: flex;
      }

      .menu-btn {
        display: block;
      }

      .nav-right .whatsapp-btn {
        display: none;
      }

      .hero-grid,
      .about-grid,
      .admission-grid,
      .contact-grid {
        grid-template-columns: 1fr;
      }

      .hero-image {
        height: 420px;
      }

      .cards {
        grid-template-columns: repeat(2,1fr);
      }

      .gallery {
        grid-template-columns: repeat(2,1fr);
      }
    }

    @media (max-width: 600px) {

      .navbar {
        min-height: 70px;
      }

      .logo-text strong {
        font-size: 13px;
      }

      .hero {
        padding: 55px 0 70px;
      }

      .hero h1 {
        font-size: 43px;
      }

      .hero p {
        font-size: 15px;
      }

      .hero-image {
        height: 320px;
        border-radius: 20px;
      }

      .floating-card {
        left: 10px;
        bottom: -20px;
      }

      section {
        padding: 65px 0;
      }

      .about-content h2,
      .admission h2 {
        font-size: 32px;
      }

      .cards {
        grid-template-columns: 1fr;
      }

      .gallery {
        grid-template-columns: 1fr 1fr;
      }

      .gallery img {
        height: 150px;
      }

      .values {
        grid-template-columns: 1fr;
      }

      .footer-content {
        flex-direction: column;
        text-align: center;
      }
    }
  </style>
</head>

<body>

  <!-- ================= HEADER ================= -->

  <header>
    <div class="container navbar">

